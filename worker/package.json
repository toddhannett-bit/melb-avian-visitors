{
  "name": "melb-avian-visitors-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BirdWeather-backed shim serving the AvianVisitors frontend's birdnet-api.php contract",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secret:set": "wrangler secret put SITE_PASSWORD",
    "secret:delete": "wrangler secret delete SITE_PASSWORD",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.js",
    "live": "node --experimental-strip-types test/live.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.135.0"
  }
}
